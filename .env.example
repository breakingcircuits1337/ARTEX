# Docker deployment configuration (copy to .env)
# docker-compose.yml builds the image locally. docker-compose.ghcr.yml pulls the
# released GHCR image; pin it with ARTEX_IMAGE_TAG (latest or a vX.Y.Z tag).
# Address the web UI is published on. 127.0.0.1 keeps it host-local; set 0.0.0.0
# to reach it from another machine or from Windows when ARTEX runs inside WSL.
# ARTEX-DEFENSE packaged installs default to passive defense.
# Set ARTEX_MODE=pentest only for authorized active testing.
ARTEX_MODE=defense
# PR #14–15: explicitly consented AI advisory is disabled by default.
# Enabling can send categorical case metadata to a configured (possibly remote) LLM.
# Configure and approve a provider, then preview + consent per request in the SOC.
ARTEX_DEFENSE_AI_ASSIST_ENABLED=0
# Emergency containment is disabled unless you configure a defense deployment,
# a strict destination scope, and explicitly arm it from the dashboard.
# Values: off | simulate | nftables (requires a pre-provisioned host kernel set)
ARTEX_AUTO_CONTAIN_MODE=off
# Unix socket of the separately privileged local nftables helper (live mode).
ARTEX_AUTO_CONTAIN_SOCKET=/run/artex/emergency.sock
# IPv4 CIDRs of systems the *destination* sensor is allowed to protect.
# ARTEX_AUTO_CONTAIN_PROTECTED_CIDRS=203.0.113.0/24
ARTEX_AUTO_CONTAIN_PROTECTED_CIDRS=
# Extra never-block-source ranges (private/reserved are always excluded).
ARTEX_AUTO_CONTAIN_EXEMPT_CIDRS=
# Exact approved Suricata alert signatures that MAY trigger emergency blocks.
# Empty disables IDS-triggered auto-blocks (Wazuh spray policy remains separate).
ARTEX_AUTO_CONTAIN_SURICATA_SIGNATURES=
# Live mode does NOT auto-block traffic to private/OT destinations by default.
# Requires independent site safety/change-control authorization before true.
ARTEX_AUTO_CONTAIN_ALLOW_PRIVATE_DESTS=false
# Short kernel expiry and strict maximum concurrent/hourly actions.
ARTEX_AUTO_CONTAIN_TTL_SECONDS=120
ARTEX_AUTO_CONTAIN_MAX_ACTIVE=20
ARTEX_AUTO_CONTAIN_MAX_PER_HOUR=50
ARTEX_BIND_ADDR=127.0.0.1
# Reverse proxies (comma-separated CIDRs) whose X-Forwarded-For the login rate
# limit trusts. Empty: the header is ignored. See "Reverse proxy deployment" in README.md.
ARTEX_TRUSTED_PROXIES=
# Optional key for the secrets encrypted in the database (32 bytes, base64 or hex,
# e.g. `openssl rand -base64 32`). Empty: keys/secret.key, generated at first start.
# Set it when ./keys is not persistent. Losing the key loses the stored secrets.
# ARTEX_SECRET_KEY=
POSTGRES_USER=artex
# The server percent-encodes this into the connection URL, so / ? % @ : and
# spaces are safe. Quote a value that contains #, and write $$ for a literal $,
# because Compose reads this file that way.
# REQUIRED: set a unique strong password before docker compose up; do not ship a shared placeholder.
POSTGRES_PASSWORD=
POSTGRES_DB=artex
# Prebuilt GHCR image tag for docker-compose.ghcr.yml. Unset uses latest.
# ARTEX_IMAGE_TAG=latest

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
# Allow the UI model list to reach a local Ollama, e.g. host.docker.internal:11434
ARTEX_LLM_PRIVATE_ENDPOINTS=

# Untrusted-output boundary. Frames every tool output between nonce-tagged markers so
# the model treats it as data, not instructions. On by default (unset or empty = on);
# set ARTEX_UNTRUSTED_BOUNDARY=0 (or false/off/no) to disable it. Measured cost: about
# 154 bytes per tool result plus one system note.
# ARTEX_UNTRUSTED_BOUNDARY=0

# Noise profile of the requests ARTEX sends to targets (WebFetch, http custom tools, enrich
# probe). Default off: no limit, requests unchanged. quiet = 2 req/s per host, burst 4,
# 1 in flight; balanced = 5 req/s, burst 10, 2 in flight; aggressive = 20 req/s, burst 40,
# 4 in flight. A profile also adds jitter, backs off on 429/503 and merges identical GETs
# of one task per tool (short cache; WebFetch is paced only). Bash-launched tools are not throttled.
# ARTEX_NOISE_PROFILE=balanced
# User-Agent set on target requests that have none, only under a profile. Empty = unchanged.
# ARTEX_TARGET_USER_AGENT=

# Run budgets (optional). Unset or 0 = unlimited, nothing changes. TASK_* caps a whole task
# (planner rounds and all its workers); INTENT_* caps one worker run. Kept in memory: a
# restart, or a revive of a finished task, starts a fresh budget.
# Below 50000 tokens a task gets no worker at all (one worker costs about 50000 tokens by
# default); from 50000 to about 70000 it typically gets one worker, then the forced wrap-up. Use a
# budget well above 70000 for real exploration.
# ARTEX_TASK_BUDGET_TOKENS=
# ARTEX_TASK_BUDGET_TURNS=
# ARTEX_INTENT_BUDGET_TOKENS=
# ARTEX_INTENT_BUDGET_TURNS=

# Update banner (optional). ARTEX_UPDATE_CHECK=1 lets the backend check the public GitHub
# releases API for a newer ARTEX release at most once per 24 h and show a dismissible banner.
# Off by default: unset, no update request is made.
# ARTEX_UPDATE_CHECK=1
